    <Compile Include="../../../Assets/Scripts/Multiplayer/LanGameOrderCodec.cs" Link="LanGameOrderCodec.cs" />
    <Compile Include="../../../Assets/Scripts/Multiplayer/MatchAuthority.cs" Link="MatchAuthority.cs" />
    <Compile Include="../../../Assets/Scripts/Multiplayer/NetworkActorIdentity.cs" Link="NetworkActorIdentity.cs" />
    <Compile Include="../../../Assets/Scripts/Multiplayer/ServerWorldProbe.cs" Link="ServerWorldProbe.cs" />
