  m_Script: {fileID: 11500000, guid: 43dd0bb900fd09547b54d84b9fdf69a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.UI.MovementHintUI
  _panel: {fileID: 1299689337}
  _text: {fileID: 219183100}
  _afterSeconds: 10
  _moved: 0.25
  _line: "W, A, S, D \u2014 \u0438\u0434\u0442\u0438. \u041A\u0430\u043C\u0435\u0440\u0430
    \u0438\u0434\u0451\u0442 \u0437\u0430 \u0432\u0430\u043C\u0438."
  _fromAbove: "\u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u0413\u0440\u0435\u0445\u043E\u0432\u043E\u0434\u0443,
    \u0437\u0430\u0442\u0435\u043C \u043F\u0440\u0430\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
    \u2014 \u043A\u0443\u0434\u0430 \u0438\u0434\u0442\u0438."
--- !u!114 &2024343066
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2024343056}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed0b942af7200414b94ce2f8aefabda6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.UI.CommandHintUI
  _panel: {fileID: 883926613}
  _text: {fileID: 974037314}
  _afterSeconds: 6
  _line: "\u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u0432\u043E\u0438\u043D\u0443
    \u2014 \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C. \u041F\u0440\u0430\u0432\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043F\u043E \u0437\u0435\u043C\u043B\u0435
    \u2014 \u0438\u0434\u0442\u0438 \u0442\u0443\u0434\u0430."
--- !u!114 &2024343067
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2024343056}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c25464fbb3c37df43ac6900ce038f0a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.UI.HarvestHintUI
  _panel: {fileID: 1273532458}
  _text: {fileID: 2126370920}
  _line: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    E, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C
    \u0434\u0443\u0448\u0443, \u043F\u043E\u0442\u043E\u043C R \u2014 \u0447\u0442\u043E\u0431\u044B
    \u0432\u043B\u043E\u0436\u0438\u0442\u044C \u0435\u0451 \u0432 \u0442\u0435\u043B\u043E.
    \u0427\u0435\u043C \u0434\u043E\u043B\u044C\u0448\u0435 \u043E\u043D\u0430 \u0433\u0430\u0441\u043D\u0435\u0442,
    \u0442\u0435\u043C \u043C\u0435\u043D\u044C\u0448\u0435 \u043E\u0442 \u043D\u0435\u0451
    \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F."
  _holdSeconds: 8
