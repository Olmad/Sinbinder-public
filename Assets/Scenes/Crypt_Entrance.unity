  _panel: {fileID: 2059684367}
  _text: {fileID: 1298080862}
  _afterSeconds: 10
  _moved: 0.25
  _line: "W, A, S, D \u2014 \u0438\u0434\u0442\u0438. \u041A\u0430\u043C\u0435\u0440\u0430
    \u0438\u0434\u0451\u0442 \u0437\u0430 \u0432\u0430\u043C\u0438."
  _fromAbove: "\u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u0413\u0440\u0435\u0445\u043E\u0432\u043E\u0434\u0443,
    \u0437\u0430\u0442\u0435\u043C \u043F\u0440\u0430\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
    \u2014 \u043A\u0443\u0434\u0430 \u0438\u0434\u0442\u0438."
