  m_Script: {fileID: 11500000, guid: 43dd0bb900fd09547b54d84b9fdf69a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.UI.MovementHintUI
  _panel: {fileID: 115341917}
  _text: {fileID: 2120065834}
  _afterSeconds: 10
