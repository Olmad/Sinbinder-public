  m_Script: {fileID: 11500000, guid: ed0b942af7200414b94ce2f8aefabda6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.UI.CommandHintUI
  _panel: {fileID: 142786441}
  _text: {fileID: 1429708481}
  _afterSeconds: 6
  _line: "\u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u0432\u043E\u0438\u043D\u0443
    \u2014 \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C. \u041F\u0440\u0430\u0432\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043F\u043E \u0437\u0435\u043C\u043B\u0435
    \u2014 \u0438\u0434\u0442\u0438 \u0442\u0443\u0434\u0430."
