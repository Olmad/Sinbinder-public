  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c25464fbb3c37df43ac6900ce038f0a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.UI.HarvestHintUI
  _panel: {fileID: 263118878}
  _text: {fileID: 1996351123}
  _line: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    E, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C
    \u0434\u0443\u0448\u0443, \u043F\u043E\u0442\u043E\u043C R \u2014 \u0447\u0442\u043E\u0431\u044B
    \u0432\u043B\u043E\u0436\u0438\u0442\u044C \u0435\u0451 \u0432 \u0442\u0435\u043B\u043E.
    \u0427\u0435\u043C \u0434\u043E\u043B\u044C\u0448\u0435 \u043E\u043D\u0430 \u0433\u0430\u0441\u043D\u0435\u0442,
    \u0442\u0435\u043C \u043C\u0435\u043D\u044C\u0448\u0435 \u043E\u0442 \u043D\u0435\u0451
    \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F."
  _holdSeconds: 8
--- !u!114 &1531237301
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
