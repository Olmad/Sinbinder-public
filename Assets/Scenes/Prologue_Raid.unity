  _announce: "\u041A\u0430\u0440\u0433\u0430\u043D: \xAB\u0412\u043B\u0430\u0434\u044B\u043A\u0430,
    \u043E\u043D\u0438 \u0443\u0437\u043D\u0430\u043B\u0438, \u0433\u0434\u0435 \u043D\u0430\u0448
    \u043B\u0430\u0433\u0435\u0440\u044C. \u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
    \u043E\u0442 \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u043D\u0430\u0448\u0438\u0445.
    \u0422\u044F\u0436\u0435\u043B\u043E \u044D\u0442\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u0442\u044C,
