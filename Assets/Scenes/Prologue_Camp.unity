  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.Gameplay.Inspectable
  _prompt: "F \u2014 \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C \u043D\u0430
    \u0431\u0430\u043D\u043A\u0438"
  _speaker: "\u0411\u0430\u043D\u043A\u0438 \u0434\u043B\u044F \u0434\u0443\u0448"
  _lines:
  - "\u0421\u0442\u0435\u043A\u043B\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0435.
    \u041F\u0443\u0441\u0442\u044B\u0435 \u0431\u0430\u043D\u043A\u0438 \u0436\u0434\u0443\u0442,
    \u043A\u0430\u043A \u0436\u0434\u0443\u0442 \u043F\u0443\u0441\u0442\u044B\u0435
    \u043C\u0435\u0441\u0442\u0430 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430."
  - "\u0412 \u043E\u0434\u043D\u043E\u0439 \u043E\u0433\u043E\u043D\u0451\u043A.
    \u0416\u0430\u0434\u043D\u044B\u0439 \u2014 \u043B\u044C\u043D\u0451\u0442 \u043A
    \u0441\u0442\u0435\u043D\u043A\u0435, \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u043B\u0435\u0436\u0438\u0442 \u043C\u043E\u043D\u0435\u0442\u0430."
  _focus: 0.9
  _distance: 1.1
  _reach: 1.6
  _front: {x: 0, y: 0, z: 1}
  _texts: Jars
  _death: 0
