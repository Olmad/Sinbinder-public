  _prompt: "F \u2014 \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C \u043D\u0430
    \u0431\u0430\u043D\u043A\u0438"
  _speaker: "\u0411\u0430\u043D\u043A\u0438 \u0434\u043B\u044F \u0434\u0443\u0448"
  _lines:
  - "\u041F\u0443\u0441\u0442\u044B\u0435 \u0431\u0430\u043D\u043A\u0438 \u0434\u043B\u044F
    \u0434\u0443\u0448. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432 \u043D\u0438\u0445
    \u043B\u044F\u0436\u0435\u0442 \u043A\u0442\u043E-\u0442\u043E \u0438\u0437 \u0442\u0435\u0445,
    \u043A\u0442\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430."
  - "\u0422\u0440\u0438 \u0442\u0430\u043A\u0438\u0435 \u0436\u0435 \u2014 \u0432
    \u0441\u0443\u043C\u0435 \u0443 \u043F\u043E\u044F\u0441\u0430. \u0421\u043A\u043E\u043B\u044C\u043A\u043E
    \u0431\u0430\u043D\u043E\u043A, \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0443\u0448
    \u0438 \u0443\u043D\u0435\u0441\u0451\u0448\u044C."
  _focus: 0.9
  _distance: 1.1
  _reach: 1.6
  _front: {x: 0, y: 0, z: 1}
  _texts: Jars
  _death: 0
