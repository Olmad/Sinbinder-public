    \u0437\u0434\u0435\u0441\u044C."
  - "\u041A\u0430\u0436\u0434\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u0430 \u043E\u0434\u043D\u0430\u0436\u0434\u044B
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442 \u0441\u043B\u0443\u0448\u0430\u0442\u044C\u0441\u044F
    \u0440\u0443\u043A\u0438. \u0414\u0430\u0436\u0435 \u0442\u0430, \u0447\u0442\u043E
    \u0434\u0435\u0440\u0436\u0438\u0442 \u0434\u043E\u0441\u043A\u0443."
