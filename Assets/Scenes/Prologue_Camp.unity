MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 555899100}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22c3f9e5f5e69bc4eb6a8e2cf70442df, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.Gameplay.Inspectable
  _prompt: "F \u2014 \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043A\u0430\u0440\u0442\u0443"
  _speaker: "\u041A\u0430\u0440\u0442\u0430 \u043D\u0430 \u043A\u043E\u0436\u0435"
  _lines:
  - "\u0423\u0433\u043B\u0451\u043C, \u0440\u0443\u043A\u043E\u0439 \u041A\u0430\u0440\u0433\u0430\u043D\u0430:
    \u043D\u0430\u0448 \u043B\u0430\u0433\u0435\u0440\u044C \u2014 \u043A\u0440\u0443\u0436\u043E\u043A
    \u0432 \u0441\u0430\u043C\u043E\u0439 \u0447\u0430\u0449\u0435. \u0414\u043E\u0440\u043E\u0433\u0438
    \u043A \u043D\u0435\u043C\u0443 \u043D\u0435 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u043E.
    \u041D\u0430\u0440\u043E\u0447\u043D\u043E."
  - "\u0417\u0430 \u0445\u043E\u043B\u043C\u0430\u043C\u0438 \u2014 \u0437\u0430\u0441\u0442\u0430\u0432\u0430
    \u041E\u0440\u0434\u0435\u043D\u0430, \u043F\u0435\u0440\u0435\u0447\u0451\u0440\u043A\u043D\u0443\u0442\u0430:
    \u0431\u0440\u043E\u0448\u0435\u043D\u0430. \u0422\u0443\u0434\u0430 \u0438 \u043F\u043E\u0439\u0434\u0451\u0442
    \u0432\u044B\u043B\u0430\u0437\u043A\u0430."
  - "\u0423 \u043A\u0440\u0430\u044F \u2014 \u0442\u0440\u0438 \u0444\u0438\u0433\u0443\u0440\u043A\u0438,
    \u0442\u0440\u0438 \u043E\u0442\u0440\u044F\u0434\u0430. \u041E\u0434\u043D\u0443
    \u0441\u0442\u0451\u0440\u043B\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u043C:
    \u0442\u0435, \u0447\u0442\u043E \u043B\u0435\u0433\u043B\u0438 \u0443 \u043C\u043E\u0441\u0442\u0430."
  - "\u0412 \u0441\u0430\u043C\u043E\u043C \u0443\u0433\u043B\u0443, \u043C\u0435\u043B\u043A\u043E:
    \u0441\u043A\u043B\u0435\u043F. \u0418 \u043F\u0440\u0438\u043F\u0438\u0441\u043A\u0430:
    \xAB\u0422\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0432\u0441\u0451
    \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E\xBB."
  _focus: 0
  _distance: 1
  _reach: 1.7
  _front: {x: 0, y: 0, z: 1}
  _texts: Map
  _death: 0
