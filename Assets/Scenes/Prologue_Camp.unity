    \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u0447\u0442\u043E \u043F\u0440\u0438\u043D\u0451\u0441
    \u041C\u0430\u0440\u0433\u0430 \u041A\u043E\u043F\u0430\u0442\u0435\u043B\u044C.
    \u042F \u0443\u0432\u0435\u0440\u0435\u043D, \u043E\u043D \u044D\u0442\u043E
    \u0432\u0441\u0451 \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u044B\u043A\u043E\u043F\u0430\u043B
    \u0432\u043E\u0437\u043B\u0435 \u043B\u0430\u0433\u0435\u0440\u044F\xBB."
