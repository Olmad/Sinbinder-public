  _prompt: "F \u2014 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F"
  _speaker: "\u041F\u0435\u0448\u043A\u0430"
  _lines:
  - "\u0422\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0447\u0442\u043E
    \u0434\u0432\u0438\u0433\u0430\u0435\u0448\u044C \u0438\u0445."
  - "\u041E\u043D \u0442\u043E\u0436\u0435 \u0442\u0430\u043A \u0434\u0443\u043C\u0430\u043B
    \u2014 \u0442\u043E\u0442, \u043A\u0442\u043E \u0432\u044B\u0440\u0435\u0437\u0430\u043B
    \u043C\u0435\u043D\u044F \u0438\u0437 \u043A\u043E\u0441\u0442\u0438 \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
    \u0437\u0434\u0435\u0441\u044C."
  - "\u041A\u0430\u0436\u0434\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u0430 \u043E\u0434\u043D\u0430\u0436\u0434\u044B
