  - "\u0421\u043A\u043B\u0435\u043F \u043E\u0431\u0432\u0435\u0434\u0451\u043D \u0443\u0433\u043B\u0451\u043C.
    \u0420\u044F\u0434\u043E\u043C \u043F\u0440\u0438\u043F\u0438\u0441\u043A\u0430:
    \xAB\u0422\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0432\u0441\u0451
    \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E\xBB."
  - "\u0423 \u0437\u0430\u0441\u0442\u0430\u0432\u044B \u0437\u0430 \u0445\u043E\u043B\u043C\u0430\u043C\u0438
    \u2014 \u043A\u0440\u0435\u0441\u0442: \u0431\u0440\u043E\u0448\u0435\u043D\u0430.
    \u0417\u043D\u0430\u043A \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432
    \u043D\u0430\u0434 \u043D\u0435\u0439 \u043F\u0435\u0440\u0435\u0447\u0451\u0440\u043A\u043D\u0443\u0442."
  - "\u041D\u0430 \u043A\u0440\u0430\u044E \u2014 \u0442\u0440\u0438 \u0444\u0438\u0433\u0443\u0440\u043A\u0438:
    \u0442\u0440\u0438 \u043E\u0442\u0440\u044F\u0434\u0430. \u041E\u0434\u043D\u0443
    \u0441\u0442\u0451\u0440\u043B\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
    \u2014 \u0442\u043E\u0442, \u0447\u0442\u043E \u043B\u0451\u0433 \u0443 \u043C\u043E\u0441\u0442\u0430."
  _focus: 0
  _distance: 1
