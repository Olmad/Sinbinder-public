  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22c3f9e5f5e69bc4eb6a8e2cf70442df, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.Gameplay.Inspectable
  _prompt: "F \u2014 \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u043E\u0435"
  _speaker: "\u0412\u044B\u0440\u0435\u0437\u0430\u043D\u043E \u043D\u0430 \u043A\u043E\u0440\u0435"
  _lines:
  - "\u041F\u044F\u0442\u044C \u0437\u0430\u0440\u0443\u0431\u043E\u043A \u2014 \u043F\u044F\u0442\u044C
    \u043D\u043E\u0447\u0435\u0439 \u0443 \u044D\u0442\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430.
    \u0428\u0435\u0441\u0442\u0443\u044E \u0432\u044B\u0440\u0435\u0437\u0430\u0442\u044C
    \u0431\u044B\u043B\u043E \u043D\u0435\u043A\u043E\u043C\u0443."
  - "\u0422\u043E\u043F\u043E\u0440 \u043D\u0435 \u0432\u044B\u043D\u0438\u043C\u0430\u0439.
    \u0414\u0435\u0440\u0435\u0432\u043E \u043C\u0451\u0440\u0442\u0432\u043E\u0435,
    \u0430 \u0434\u0435\u0440\u0436\u0438\u0442 \u043A\u0440\u0435\u043F\u0447\u0435
    \u0436\u0438\u0432\u043E\u0433\u043E."
  - "\u0423\u0448\u043B\u0438 \u0437\u0430 \u0441\u043E\u043B\u044C\u044E \u043D\u0430
    \u0432\u043E\u0441\u0442\u043E\u043A. \u0412\u0435\u0440\u043D\u0443\u0441\u044C
    \u2014 \u0437\u0430\u0431\u0435\u0440\u0443 \u0442\u043E\u043F\u043E\u0440. \u0422."
  - "\u041F\u043E \u043D\u043E\u0447\u0430\u043C \u0437\u0430 \u043B\u0435\u0441\u043E\u043C
    \u043A\u0442\u043E-\u0442\u043E \u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u0444\u0438\u0433\u0443\u0440\u044B.
    \u0421\u043B\u044B\u0448\u043D\u043E, \u043A\u0430\u043A \u043E\u043D\u0438 \u0441\u0442\u0443\u0447\u0430\u0442
    \u043E \u0434\u043E\u0441\u043A\u0443."
  _focus: 1.45
  _distance: 3.2
  _reach: 2.8
