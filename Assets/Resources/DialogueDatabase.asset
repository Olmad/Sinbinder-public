%TAG !u! tag:unity3d.com,2011:
--- !u!114 &-8316066645670080798
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58134b5414e857448a272e5ee6b1c665, type: 3}
  m_Name: PRE_01
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.Dialogue.DialogueSituation
  SituationName: PRE_01
  Lines:
  - Sin: 0
    Moral: 0
    Text: "\u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u043E\u0448\u0435\u043B\u044C.
      \u0421\u043A\u043E\u0440\u043E \u043E\u043D \u0431\u0443\u0434\u0435\u0442
      \u043C\u043E\u0439."
  - Sin: 0
    Moral: 1
    Text: "\u0414\u0430\u0439 \u043F\u0440\u043E\u0439\u0442\u0438 \u2014 \u0438
      \u044F \u043D\u0435 \u0441\u0442\u0430\u043D\u0443 \u0442\u0435\u0431\u044F
      \u043E\u0431\u044B\u0441\u043A\u0438\u0432\u0430\u0442\u044C."
  - Sin: 0
    Moral: 2
    Text: "\u041E\u0442\u0434\u0430\u0439, \u0447\u0442\u043E \u0432\u0437\u044F\u043B
      \u043D\u0435 \u0441\u0432\u043E\u0451, \u0438 \u0440\u0430\u0437\u043E\u0439\u0434\u0451\u043C\u0441\u044F."
  - Sin: 1
    Moral: 0
    Text: "\u0422\u044B \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0448\u044C,
      \u043A\u0442\u043E \u0442\u0435\u0431\u044F \u0443\u0431\u0438\u043B. \u0410
      \u044F \u0437\u0430\u043F\u043E\u043C\u043D\u044E."
  - Sin: 1
    Moral: 1
    Text: "\u041D\u0430\u0437\u043E\u0432\u0438\u0441\u044C. \u042F \u043D\u0435
      \u0431\u044C\u044E \u0431\u0435\u0437\u044B\u043C\u044F\u043D\u043D\u044B\u0445."
  - Sin: 1
    Moral: 2
    Text: "\u042F \u0434\u0430\u043C \u0442\u0435\u0431\u0435 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0443\u0434\u0430\u0440. \u041E\u043D \u0442\u0435\u0431\u0435 \u043D\u0435
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442."
  - Sin: 2
    Moral: 0
    Text: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E. \u042F \u0443\u0441\u0442\u0430\u043B
      \u0436\u0434\u0430\u0442\u044C."
  - Sin: 2
    Moral: 1
    Text: "\u041E\u0442\u043E\u0439\u0434\u0438. \u0412\u0442\u043E\u0440\u043E\u0439
      \u0440\u0430\u0437 \u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043D\u0435
      \u0431\u0443\u0434\u0443."
  - Sin: 2
    Moral: 2
    Text: "\u041D\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0439 \u043C\u0435\u043D\u044F.
      \u041F\u0440\u043E\u0448\u0443 \u2014 \u043D\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0439."
  - Sin: 3
    Moral: 0
    Text: "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u043A\u043B\u0438\u043D\u043E\u043A.
      \u0422\u0435\u0431\u0435 \u043E\u043D \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F."
  - Sin: 3
    Moral: 1
    Text: "\u0422\u0435\u0431\u0435 \u0432\u0435\u0437\u043B\u043E \u0434\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043C\u043D\u0435. \u042D\u0442\u043E \u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C."
  - Sin: 3
    Moral: 2
    Text: "\u0422\u0435\u0431\u0435 \u0434\u0430\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435.
      \u041D\u043E \u043D\u0435 \u043F\u0440\u0430\u0432\u043E \u044D\u0442\u0438\u043C
      \u0431\u0438\u0442\u044C."
  - Sin: 4
    Moral: 0
    Text: "\u0422\u044B \u043A\u0440\u0430\u0441\u0438\u0432\u0435\u0435, \u0447\u0435\u043C
      \u0441\u0442\u043E\u0438\u043B\u043E \u0431\u044B \u0434\u043B\u044F \u0442\u0430\u043A\u043E\u0433\u043E
      \u0434\u0435\u043B\u0430."
  - Sin: 4
    Moral: 1
    Text: "\u0416\u0430\u043B\u044C. \u041C\u044B \u043C\u043E\u0433\u043B\u0438
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F \u0438\u043D\u0430\u0447\u0435."
  - Sin: 4
    Moral: 2
    Text: "\u042F \u0437\u0430\u043F\u043E\u043C\u043D\u044E \u0442\u0432\u043E\u0451
      \u043B\u0438\u0446\u043E. \u0418 \u043F\u043E\u043C\u043E\u043B\u044E\u0441\u044C
      \u0437\u0430 \u043D\u0435\u0433\u043E."
  - Sin: 5
    Moral: 0
    Text: "\u042F \u043D\u0435 \u0435\u043B \u0441 \u0443\u0442\u0440\u0430. \u0422\u044B
      \u043E\u0447\u0435\u043D\u044C \u0432\u043E\u0432\u0440\u0435\u043C\u044F."
  - Sin: 5
    Moral: 1
    Text: "\u0414\u0430\u0432\u0430\u0439 \u0431\u044B\u0441\u0442\u0440\u0435\u0435.
      \u0423 \u043C\u0435\u043D\u044F \u0441\u0442\u044B\u043D\u0435\u0442."
  - Sin: 5
    Moral: 2
    Text: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0434\u0435\u043B\u043E, \u043F\u043E\u0442\u043E\u043C
      \u0445\u043B\u0435\u0431. \u0422\u0430\u043A \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E."
  - Sin: 6
    Moral: 0
    Text: "\u041E\u043F\u044F\u0442\u044C. \u041A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437
      \u043E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435."
  - Sin: 6
    Moral: 1
    Text: "\u041C\u043E\u0436\u0435\u0442, \u0440\u0430\u0437\u043E\u0439\u0434\u0451\u043C\u0441\u044F?
      \u041D\u0435\u0442? \u041D\u0443 \u043B\u0430\u0434\u043D\u043E."
  - Sin: 6
    Moral: 2
    Text: "\u042F \u043D\u0435 \u0445\u043E\u0442\u0435\u043B \u044D\u0442\u043E\u0433\u043E
      \u0434\u043D\u044F. \u041D\u043E \u043E\u043D \u043F\u0440\u0438\u0448\u0451\u043B."
--- !u!114 &-4742042382007466566
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58134b5414e857448a272e5ee6b1c665, type: 3}
  m_Name: JOIN_01
  m_EditorClassIdentifier: Assembly-CSharp::Sinbinder.Dialogue.DialogueSituation
  SituationName: JOIN_01
  Lines:
  - Sin: 0
    Moral: 0
    Text: "\u0410 \u0434\u0435\u043B\u0438\u0442\u044C \u0431\u0443\u0434\u0435\u043C
      \u043D\u0430 \u0432\u0441\u0435\u0445? \u0422\u043E\u0433\u0434\u0430 \u044F
      \u0432 \u0434\u0435\u043B\u0435."
  - Sin: 0
    Moral: 1
    Text: "\u042F \u0443\u0441\u043B\u044B\u0448\u0430\u043B \u0441\u043B\u043E\u0432\u043E
      \xAB\u043A\u043E\u0448\u0435\u043B\u044C\xBB. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435."
  - Sin: 0
    Moral: 2
    Text: "\u0425\u0432\u0430\u0442\u0438\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430\u0434 \u0436\u0438\u0432\u044B\u043C\u0438."
  - Sin: 1
    Moral: 0
    Text: "\u0412\u044B \u043E\u0431\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E \u0434\u043B\u044F
      \u043C\u0435\u0440\u0442\u0432\u0435\u0446\u043E\u0432."
  - Sin: 1
    Moral: 1
    Text: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435. \u041F\u043E\u0442\u043E\u043C
      \u043C\u043E\u044F \u043E\u0447\u0435\u0440\u0435\u0434\u044C."
  - Sin: 1
    Moral: 2
    Text: "\u0414\u0430\u0439\u0442\u0435 \u0438\u043C \u0441\u043A\u0430\u0437\u0430\u0442\u044C.
      \u041A\u0430\u0436\u0434\u043E\u043C\u0443 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E
      \u0441\u043B\u043E\u0432\u043E."
  - Sin: 2
    Moral: 0
    Text: "\u0425\u0432\u0430\u0442\u0438\u0442 \u0431\u043E\u043B\u0442\u0430\u0442\u044C.
      \u041D\u0430\u0447\u0438\u043D\u0430\u0439\u0442\u0435 \u0443\u0436\u0435."
  - Sin: 2
    Moral: 1
    Text: "\u0415\u0449\u0451 \u0441\u043B\u043E\u0432\u043E \u2014 \u0438 \u044F
      \u043D\u0430\u0447\u043D\u0443 \u0431\u0435\u0437 \u0432\u0430\u0441."
  - Sin: 2
    Moral: 2
    Text: "\u0417\u0430\u043C\u043E\u043B\u0447\u0438\u0442\u0435 \u043E\u0431\u0430.
      \u041A\u0440\u043E\u0432\u044C \u0438 \u0442\u0430\u043A \u0431\u043B\u0438\u0437\u043A\u043E."
  - Sin: 3
    Moral: 0
    Text: "\u0410 \u043F\u043E\u0447\u0435\u043C\u0443 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u0441 \u043D\u0438\u043C, \u0430 \u043D\u0435 \u0441\u043E \u043C\u043D\u043E\u0439?"
  - Sin: 3
    Moral: 1
    Text: "\u042F \u0442\u043E\u0436\u0435 \u0437\u0434\u0435\u0441\u044C. \u041D\u0430
      \u0441\u043B\u0443\u0447\u0430\u0439, \u0435\u0441\u043B\u0438 \u0437\u0430\u0431\u044B\u043B\u0438."
  - Sin: 3
    Moral: 2
    Text: "\u041D\u0435 \u043C\u043D\u0435 \u0437\u0430\u0432\u0438\u0434\u043E\u0432\u0430\u0442\u044C
      \u0447\u0443\u0436\u043E\u043C\u0443 \u0441\u043B\u043E\u0432\u0443. \u0418
      \u0432\u0441\u0451 \u0436\u0435."
  - Sin: 4
    Moral: 0
    Text: "\u042F \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u044E. \u041C\u043D\u0435
      \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u043A\u0430\u043A \u043E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442."
  - Sin: 4
    Moral: 1
    Text: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439. \u0422\u044B \u0445\u043E\u0440\u043E\u0448\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C."
  - Sin: 4
    Moral: 2
    Text: "\u0421\u043B\u043E\u0432\u0430 \u043A\u0440\u0430\u0441\u0438\u0432\u044B.
      \u0414\u0435\u043B\u0430 \u0431\u0443\u0434\u0443\u0442 \u0445\u0443\u0436\u0435."
  - Sin: 5
    Moral: 0
    Text: "\u041F\u043E\u043A\u0430 \u0432\u044B \u0441\u043F\u043E\u0440\u0438\u0442\u0435,
      \u044F \u0443\u0441\u043F\u0435\u044E \u043F\u0435\u0440\u0435\u043A\u0443\u0441\u0438\u0442\u044C."
  - Sin: 5
    Moral: 1
    Text: "\u0414\u043E\u043B\u0433\u043E \u0435\u0449\u0451? \u042F \u0433\u043E\u043B\u043E\u0434\u0435\u043D."
  - Sin: 5
    Moral: 2
    Text: "\u041F\u043E\u0441\u043F\u0435\u0448\u0438\u0442\u0435. \u041C\u0451\u0440\u0442\u0432\u044B\u0435
      \u043D\u0435 \u0435\u0434\u044F\u0442."
  - Sin: 6
    Moral: 0
    Text: "\u0420\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u0435, \u043A\u043E\u0433\u0434\u0430
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435."
  - Sin: 6
    Moral: 1
    Text: "\u042F \u043F\u043E\u0441\u0442\u043E\u044E. \u041C\u043D\u0435 \u0438
      \u043E\u0442\u0441\u044E\u0434\u0430 \u0441\u043B\u044B\u0448\u043D\u043E."
  - Sin: 6
    Moral: 2
    Text: "\u041F\u0443\u0441\u0442\u044C \u0433\u043E\u0432\u043E\u0440\u044F\u0442.
      \u041C\u043E\u0436\u0435\u0442, \u043E\u0431\u043E\u0439\u0434\u0451\u0442\u0441\u044F."
