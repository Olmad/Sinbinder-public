// ОТЛОЖЕНО ДО ОСНОВНОЙ ИГРЫ
//
// Черновик полной версии, написанный локальной сессией 4 сентября.
// В демо не идёт: Морган в прологе не появляется (00-GDD.md §4),
// заклинания Греховода кроме Приказа не реализованы (00-GDD.md §6.1).
// Идеи полной версии ведутся в docs/15-AFTER.md — этот файл только код.
// Вернуть: убрать .later из имени, папка MainGame больше ничего не требует.
//
//
// ЧЕРНОВИК ОСНОВНОЙ ИГРЫ — добавить в основную игру.
// Не вызывается ниоткуда, ни на один UI не повешен. Написан в ночь
// на 4 сентября 2026 по прямому поручению автора — см. заголовок
// Morgan.cs в этой же папке для полного объяснения статуса.
//
// Источник — 00-GDD.md §6.1, восьмой рычаг игрока: «Заклинания
// Греховода — Приказ, Жатва, Порабощение, Вопль, Призыв — спроектировано».
// Приказ уже существует как механика (Warrior.Command, не заклинание
// в этом файле). Здесь — оставшиеся четыре.
using UnityEngine;

namespace Sinbinder.MainGame
{
    public enum SpellType
    {
        Harvest,      // Жатва
        Enslavement,  // Порабощение
        Scream,       // Вопль
        Summon,       // Призыв
    }

    /// <summary>
    /// Статус каждого заклинания — что уже лежит в движке готовым куском,
    /// а что нужно писать с нуля. Не механика, а карта территории для
    /// того, кто будет это реализовывать.
    /// </summary>
    public static class Spellbook
    {
        /// <summary>
        /// Человекочитаемый статус. Не для игрока — тот не видит чисел
        /// и не видит списков заклинаний, которых ещё нет.
        /// </summary>
        public static string Status(SpellType spell)
        {
            switch (spell)
            {
                case SpellType.Harvest:
                    // Половина уже есть и работает в демо, просто не как
                    // заклинание игрока: Core.SoulDecay.Harvest считает
                    // потери качества, Gameplay.SoulManager.TryHarvestSoul
                    // и HarvestableSoul.Harvest достают душу из мёртвого
                    // тела в бою. Не хватает: явного каста (стоимость,
                    // время, дальность) вместо автоматического подбора.
                    return "Наполовину готово: сбор души уже есть в бою, "
                         + "не хватает подачи как действия игрока.";

                case SpellType.Enslavement:
                    // Ближайший родственник в коде — ShellBinder (одна
                    // душа, одна оболочка) и вербовка через TemptationResolver
                    // (снаряжение как рычаг). Порабощение — это, вероятно,
                    // принуждение живого воина сменить сторону без смерти;
                    // такого пути сейчас нет вообще, только AutoBattleResolver
                    // умеет подкуп между уже мёртвыми/автономными боями.
                    return "Не начато. Ближе всего ShellBinder и подкуп "
                         + "в AutoBattleResolver, но оба — не то же самое.";

                case SpellType.Scream:
                    // Голос уже синтезируется кодом (Audio.VoiceGenerator).
                    // Вопль, вероятно, массовый эффект на эмоции/страх
                    // отряда врага — EmotionSystem.TriggerEmotion уже умеет
                    // адресно, группового вызова нет.
                    return "Не начато. EmotionSystem.TriggerEmotion делает "
                         + "адресную часть, группового вызова нет.";

                case SpellType.Summon:
                    // Призыв — вероятно, спавн временного союзника вне
                    // связывания душ. UnitFactory уже умеет создавать
                    // воинов рантаймом; чего нет — источника вызываемой
                    // души и правила, когда она исчезает.
                    return "Не начато. UnitFactory умеет создавать воинов, "
                         + "источник души для призыва не определён.";

                default:
                    return "Неизвестное заклинание.";
            }
        }
    }
}
