// ОТЛОЖЕНО ДО ОСНОВНОЙ ИГРЫ
//
// Черновик полной версии, написанный локальной сессией 4 сентября.
// В демо не идёт: Морган в прологе не появляется (00-GDD.md §4),
// заклинания Греховода кроме Приказа не реализованы (00-GDD.md §6.1).
// Идеи полной версии ведутся в docs/15-AFTER.md — этот файл только код.
// Вернуть: убрать .later из имени, папка MainGame больше ничего не требует.
//
//
// ЧЕРНОВИК ОСНОВНОЙ ИГРЫ — добавить в основную игру.
// Не вызывается ниоткуда, ни на одну сцену не повешен, ни один
// спавнер о нём не знает. Написан в ночь на 4 сентября 2026 по прямому
// поручению автора («начинай основную игру, файлы отдельно, чтобы
// не мешали демо») и ждёт его решения перед тем, как на него можно
// будет положиться. Компилируется вместе с демо, но это не значит,
// что он в игре — это значит только то, что он не сломан.
//
// Источник — 00-GDD.md §4: «Протагонист полной версии — Морган,
// наследник Корвина, величайшего из Греховодов. Начинает изгоем:
// дар Связывания при нём, дара Сбора нет — нужен Перстень Скорби.
// В демо Морган не появляется».
//
// Разделение с демо не косметическое (13-DRIFT.md §1): SinbinderPlayer —
// безымянный полевой командир без лица, Морган — сюжетная фигура
// с родом, долгом и убитым учителем. Общий предок — Warrior, как
// у SinbinderPlayer, потому что оба нуждаются в одном и том же:
// личность, голосование отряда, приказ.
using UnityEngine;

namespace Sinbinder.MainGame
{
    /// <summary>
    /// Протагонист полной версии. См. заголовок файла — не подключено.
    ///
    /// Два дара Греховода не равны у Моргана изначально:
    /// <see cref="HasBindingGift"/> (Связывание — вселить душу в оболочку)
    /// есть с самого начала, <see cref="HasCollectionGift"/> (Сбор —
    /// извлечь душу из умершего) появляется только после того, как
    /// сюжет отдаёт ему Перстень Скорби. До этого момента Морган
    /// не может делать то, что безымянный Греховод в демо делает
    /// с первой минуты, — и это открытый вопрос, а не забытая мелочь:
    /// как ограничение дара выражается в голосовании и в интерфейсе,
    /// решает автор, не этот файл.
    /// </summary>
    public class Morgan : Gameplay.Warrior
    {
        public static Morgan Instance { get; private set; }

        [Tooltip("Есть с начала полной версии — вселять души в оболочки.")]
        [SerializeField] private bool _hasBindingGift = true;

        [Tooltip("Открывается сюжетно, Перстнем Скорби — извлекать душу "
               + "из умершего. До этого момента Морган не может собирать.")]
        [SerializeField] private bool _hasCollectionGift = false;

        public bool HasBindingGift => _hasBindingGift;
        public bool HasCollectionGift => _hasCollectionGift;

        /// <summary>Сюжетный момент получения Перстня Скорби. Не вызывается.</summary>
        public void GrantCollectionGift() => _hasCollectionGift = true;

        void Awake()
        {
            if (Instance == null) Instance = this;
            else if (Instance != this) Destroy(gameObject);
        }

        void OnDestroy()
        {
            if (Instance == this) Instance = null;
        }
    }
}
