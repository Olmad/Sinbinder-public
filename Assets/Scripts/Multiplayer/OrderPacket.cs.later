// ОТЛОЖЕНО ДО ОСНОВНОЙ ИГРЫ
//
// См. NetTick.cs.later — там объяснено, почему вся папка отложена.

namespace Sinbinder.Multiplayer
{
    /// <summary>
    /// Что уходит по сети. Всё остальное каждый участник вычисляет сам.
    ///
    /// Умышленно бедный. В пакете нет ни позиции воина, ни его здоровья,
    /// ни выбранного действия — только чего от него хотят. Что он на это
    /// решит, каждый участник посчитает своим движком и получит тот же
    /// ответ, потому что движок детерминирован.
    ///
    /// Класть в пакет результат было бы проще и хуже: тогда один участник
    /// стал бы главным, а голосование — его частным мнением, которое
    /// остальным сообщают. Игра про то, что решает душа, а не про то,
    /// что решает хост.
    /// </summary>
    public struct OrderPacket
    {
        /// <summary>На каком шаге исполняется. Назначает <see cref="NetTick.Plan"/>.</summary>
        public long Tick;

        /// <summary>Кто приказал. Не «игрок номер один», а конкретный Греховод.</summary>
        public int CommanderId;

        /// <summary>
        /// Кому. Общий номер из <see cref="NetIdentity"/>, а не
        /// <c>Warrior.Id</c>: тот создаётся как <c>Guid.NewGuid</c>
        /// и свой у каждой машины. Первая редакция этого файла клала
        /// сюда именно его, и пакет уходил бы с номером, которого
        /// у получателя нет.
        /// </summary>
        public int WarriorNet;

        /// <summary>Чего от него хотят: «Attack», «Move», «Hold», «FallBack».</summary>
        public string Kind;

        // Точка приказа. Три числа вместо Vector3: структура обязана
        // сериализоваться одинаково у всех, а UnityEngine.Vector3 тянет
        // за собой сборку, которой на выделенном сервере может не быть.
        public float X, Y, Z;

        /// <summary>
        /// Порядок исполнения внутри одного шага.
        ///
        /// Нужен именно строгий и одинаковый у всех. Два приказа,
        /// пришедшие на один шаг, разные участники получат в разном
        /// порядке — сеть этого не обещает, — и если исполнить их
        /// в порядке получения, миры разойдутся на первом же воине,
        /// которому приказали двое.
        ///
        /// Сортируем по командиру, потом по воину, потом по приказу.
        /// Ни одно из трёх полей не зависит от того, кто когда получил
        /// пакет.
        /// </summary>
        public static int Compare(OrderPacket a, OrderPacket b)
        {
            if (a.CommanderId != b.CommanderId)
                return a.CommanderId.CompareTo(b.CommanderId);

            if (a.WarriorNet != b.WarriorNet)
                return a.WarriorNet.CompareTo(b.WarriorNet);

            return string.CompareOrdinal(a.Kind, b.Kind);
        }
    }
}
