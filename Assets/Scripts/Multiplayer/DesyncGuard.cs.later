// ОТЛОЖЕНО ДО ОСНОВНОЙ ИГРЫ
//
// См. NetTick.cs.later — там объяснено, почему вся папка отложена.

using System.Collections.Generic;
using Sinbinder.AOS;
using Sinbinder.Gameplay;

namespace Sinbinder.Multiplayer
{
    /// <summary>
    /// Ловец рассинхрона.
    ///
    /// В шаговой схеме миры участников обязаны совпадать до последнего
    /// решения. Если где-то в движке заведётся недетерминированность —
    /// <c>Random</c>, <c>Time.deltaTime</c> в решении, обход объектов
    /// без заданного порядка, — миры разойдутся тихо. Игроки увидят это
    /// минут через десять, когда у одного воин жив, а у другого мёртв,
    /// и восстановить причину будет уже нельзя.
    ///
    /// Поэтому каждые несколько шагов участники обмениваются отпечатком
    /// состояния и сверяют его. Расхождение обязано быть слышно
    /// <b>в тот же миг</b>, а не в конце партии.
    ///
    /// Это ровно то же правило, по которому в проекте живут SceneDoctor
    /// и check.py: поломка, которую видно сразу, стоит вечер; поломка,
    /// которую видно через неделю, стоит недели.
    ///
    /// <b>Отпечаток берётся только с того, что решает исход.</b> Ни
    /// позиций, ни поворотов, ни анимаций: они у участников расходятся
    /// законно (разные кадры, разная интерполяция), и включив их
    /// в отпечаток, мы получили бы вечную ложную тревогу.
    /// </summary>
    public static class DesyncGuard
    {
        /// <summary>Через сколько шагов сверяться. Раз в секунду при двадцати шагах.</summary>
        public const int EveryTicks = 20;

        /// <summary>
        /// Отпечаток состояния, от которого зависят решения.
        ///
        /// Порядок берётся из <see cref="NetIdentity"/>, а не из обхода
        /// сцены и не из <c>Warrior.Id</c>. Первая редакция сортировала
        /// и хэшировала именно по <c>Warrior.Id</c> — и это была ошибка,
        /// которая обесценивала весь прибор: идентификатор создаётся как
        /// <c>Guid.NewGuid</c>, свой у каждой машины, и отпечатки
        /// разошлись бы на первой же сверке в идеально синхронной партии.
        /// </summary>
        public static ulong Fingerprint(NetIdentity ids)
        {
            if (ids == null) return 0UL;

            ulong hash = 1469598103934665603UL;   // FNV-1a, 64 бита

            foreach (var w in ids.InOrder())
            {
                if (w == null) continue;

                Mix(ref hash, ids.NumberOf(w));
                Mix(ref hash, w.IsDead ? 1 : 0);

                // Здоровье и усталость округляем: у участников они
                // считаются одинаково, но копятся сложением с плавающей
                // точкой, и последний бит имеет право разойтись.
                // Сверять надо то, что меняет решение, а решение
                // не меняется от тысячной доли единицы.
                Mix(ref hash, (int)(w.HP * 10f));
                Mix(ref hash, (int)(w.Loyalty * 10f));
                Mix(ref hash, w.UnpaidMissions);

                if (w.Soul == null) continue;

                for (int i = 0; i < Core.SoulData.SpectrumCount; i++)
                    Mix(ref hash, (int)(w.Soul.Get((Core.SinType)i) * 10f));
            }

            return hash;
        }

        private static void Mix(ref ulong hash, int value)
        {
            for (int i = 0; i < 4; i++)
            {
                hash ^= (ulong)((value >> (i * 8)) & 0xFF);
                hash *= 1099511628211UL;
            }
        }

        private static void Mix(ref ulong hash, string value)
        {
            if (string.IsNullOrEmpty(value)) { Mix(ref hash, 0); return; }

            foreach (char c in value)
            {
                hash ^= c;
                hash *= 1099511628211UL;
            }
        }

        /// <summary>
        /// Что сказать игроку, когда отпечатки разошлись.
        ///
        /// Без цифр — правило игры не отменяется техническим сбоем.
        /// И без обвинений: виноват не участник, а движок, и знать
        /// об этом должен разработчик, а не тот, кому не повезло.
        /// </summary>
        public const string Diverged =
            "Связь потеряна: ваши миры разошлись. Партия остановлена.";
    }
}
