// ОТЛОЖЕНО ДО ОСНОВНОЙ ИГРЫ
//
// Этот файл не компилируется: расширение .cs.later Unity не знает, и в
// сборку демо он не попадает. Код цел и ждёт — вернуть его в игру значит
// убрать «.later» из имени.
//
// Почему отложено: мультиплеер — решение об архитектуре, а не фича, и
// браться за него можно только после того, как демо продалось
// (docs/15-AFTER.md §1). Здесь лежит не сеть, а та её часть, которая
// является дизайном: как расходятся приказы двух Греховодов и чем
// ловится рассинхрон.
//
// Что здесь НЕ лежит намеренно: транспорт. Ни сокетов, ни Netcode for
// GameObjects, ни выбора библиотеки. Транспорт — сменная деталь, а всё
// остальное в этой папке от него не зависит и переживёт любой выбор.

using System.Collections.Generic;

namespace Sinbinder.Multiplayer
{
    /// <summary>
    /// Шаговая синхронизация: по сети идут приказы, а не состояние мира.
    ///
    /// Схема выбрана не из экономии, а потому что она уже оплачена.
    /// Правило проекта «одинаковый вход обязан давать одинаковый выход»
    /// держится с самого начала и по другой причине — чтобы игрок мог
    /// учиться на объяснениях. Но это ровно то условие, при котором
    /// шаговая синхронизация работает: у всех участников одна и та же
    /// последовательность решений, и передавать надо только приказы.
    ///
    /// Мир при этом не пересылается никогда. Девять воинов, тринадцать
    /// модулей и вся память отряда весят несколько килобайт на кадр,
    /// а приказ — десятки байт и появляется несколько раз в минуту.
    ///
    /// <b>Нерешённое, и оно крупное.</b> Решения читают положение
    /// (<c>CombatDecisionContext</c> меряет расстояния по transform),
    /// а двигает воинов NavMeshAgent, который не обещает одинакового
    /// шага на двух машинах. Пока это не решено, чистая шаговая схема
    /// не работает — разбор трёх выходов в docs/15-AFTER.md §1,
    /// «Главная нерешённая задача: движение». Этот файл верен для
    /// приказов при любом из них.
    ///
    /// <b>Цена схемы:</b> любое расхождение в вычислениях — не мелкая
    /// ошибка, а конец партии. Поэтому рядом лежит
    /// <see cref="DesyncGuard"/>, и поэтому же в решениях запрещены
    /// <c>Random</c>, <c>Time.deltaTime</c> и обход объектов без
    /// заданного порядка. Первое и третье проверяет check.py уже сейчас,
    /// задолго до всякой сети.
    /// </summary>
    public sealed class NetTick
    {
        /// <summary>
        /// Сколько шагов в секунде. Не кадров: кадры у участников разные,
        /// а шаг обязан быть общим. Двадцать — с запасом для тактики,
        /// где решения принимаются реже, чем рисуются кадры.
        /// </summary>
        public const int PerSecond = 20;

        public const float Step = 1f / PerSecond;

        /// <summary>
        /// На сколько шагов вперёд планируется приказ.
        ///
        /// Приказ, отданный сейчас, исполняется через <see cref="Delay"/>
        /// шагов — у всех одновременно. Задержка нужна, чтобы пакет успел
        /// дойти; она же и есть тот самый «инпут-лаг» шаговых схем.
        ///
        /// Три шага — сто пятьдесят миллисекунд. Для игры, где приказ
        /// и так проходит через голосование и может проиграть, это
        /// незаметно: игрок не ждёт мгновенного отклика от того, кто
        /// имеет право не послушаться.
        /// </summary>
        public const int Delay = 3;

        private readonly Dictionary<long, List<OrderPacket>> _planned = new();

        private float _carried;

        /// <summary>Текущий шаг. Растёт только через <see cref="Advance"/>.</summary>
        public long Now { get; private set; }

        /// <summary>
        /// Положить приказ в очередь. Шаг исполнения считается здесь,
        /// а не отправителем: два участника с разными часами иначе
        /// назначили бы разные шаги одному и тому же приказу.
        /// </summary>
        public OrderPacket Plan(OrderPacket order)
        {
            order.Tick = Now + Delay;

            if (!_planned.TryGetValue(order.Tick, out var list))
            {
                list = new List<OrderPacket>();
                _planned[order.Tick] = list;
            }

            list.Add(order);
            return order;
        }

        /// <summary>Принять приказ, пришедший по сети, на уже назначенный шаг.</summary>
        public bool Accept(OrderPacket order)
        {
            // Опоздавший приказ исполнять нельзя: у других он уже прошёл,
            // и исполнить его позже значит развести миры. Партия честнее
            // потеряет один приказ, чем разойдётся.
            if (order.Tick <= Now) return false;

            if (!_planned.TryGetValue(order.Tick, out var list))
            {
                list = new List<OrderPacket>();
                _planned[order.Tick] = list;
            }

            list.Add(order);
            return true;
        }

        /// <summary>
        /// Продвинуть часы на прошедшее время и вернуть приказы шагов,
        /// которые наступили. Порядок внутри шага строго задан — иначе
        /// два участника исполнили бы одни и те же приказы в разном
        /// порядке и разошлись бы на первом же спорном воине.
        /// </summary>
        public List<OrderPacket> Advance(float deltaSeconds)
        {
            var due = new List<OrderPacket>();

            _carried += deltaSeconds;

            while (_carried >= Step)
            {
                _carried -= Step;
                Now++;

                if (!_planned.TryGetValue(Now, out var list)) continue;

                list.Sort(OrderPacket.Compare);
                due.AddRange(list);
                _planned.Remove(Now);
            }

            return due;
        }
    }
}
