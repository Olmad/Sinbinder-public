// ОТЛОЖЕНО ДО ОСНОВНОЙ ИГРЫ
//
// См. NetTick.cs.later — там объяснено, почему вся папка отложена.
//
// Этот файл появился из ошибки в соседних. Первая редакция OrderPacket
// и DesyncGuard опиралась на Warrior.Id, и это было неверно: он
// создаётся как System.Guid.NewGuid() и потому свой у каждой машины
// и даже у каждого запуска. Пакет уходил бы с номером, которого
// у получателя нет, а отпечаток состояния расходился бы на первой же
// сверке в идеально синхронной партии — прибор ловил бы собственную тень.
//
// Ошибка стоит того, чтобы остаться записанной: она выглядела правильным
// кодом и не ловится ни одной проверкой. check.py запрещает Guid.NewGuid
// в файлах решения, а Warrior.cs — не файл решения, и запрещать его там
// нельзя: в одиночной игре случайный номер совершенно законен.

using System.Collections.Generic;
using Sinbinder.Gameplay;

namespace Sinbinder.Multiplayer
{
    /// <summary>
    /// Общий номер воина: одинаковый у всех участников партии.
    ///
    /// В шаговой схеме участники не обмениваются миром — они его
    /// вычисляют, каждый у себя. Значит любой номер, посчитанный
    /// локально из случайности или из времени, разводит их немедленно.
    /// Нужен номер, который получается <b>из одинаковых действий</b>,
    /// а не из машины.
    ///
    /// Такой номер здесь один: <b>порядок появления</b>. Все участники
    /// исполняют одну и ту же последовательность приказов и потому
    /// создают воинов в одном и том же порядке — значит счётчик даёт
    /// у всех одно и то же.
    ///
    /// <b>Что это значит для остального кода.</b> Всякий раз, когда
    /// воин появляется вне общей последовательности — спавнер, поднятый
    /// связыванием, вторая волна, — он обязан получить номер здесь
    /// и в том же месте у всех. Забыть это негде: без номера воину
    /// нельзя отдать приказ по сети.
    /// </summary>
    public sealed class NetIdentity
    {
        private readonly Dictionary<Warrior, int> _byWarrior = new();
        private readonly Dictionary<int, Warrior> _byNumber = new();

        private int _next;

        /// <summary>
        /// Выдать следующий номер. Зовётся в порядке появления воинов
        /// и только оттуда: два разных места вызова с разным порядком
        /// разведут партию так же надёжно, как случайный номер.
        /// </summary>
        public int Register(Warrior warrior)
        {
            if (warrior == null) return -1;
            if (_byWarrior.TryGetValue(warrior, out var known)) return known;

            int number = _next++;
            _byWarrior[warrior] = number;
            _byNumber[number] = warrior;
            return number;
        }

        public int NumberOf(Warrior warrior)
            => warrior != null && _byWarrior.TryGetValue(warrior, out var n) ? n : -1;

        public Warrior ByNumber(int number)
            => _byNumber.TryGetValue(number, out var w) ? w : null;

        /// <summary>
        /// Все воины в общем порядке — для отпечатка состояния.
        ///
        /// Порядок берётся из номеров, а не из обхода сцены:
        /// FindObjectsByType даже с InstanceID устойчив только внутри
        /// одного запуска и между машинами не обещает ничего.
        /// </summary>
        public List<Warrior> InOrder()
        {
            var all = new List<Warrior>();
            for (int i = 0; i < _next; i++)
                if (_byNumber.TryGetValue(i, out var w) && w != null) all.Add(w);

            return all;
        }
    }
}
